{
  "name": "behind-the-interface",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "yarn": "1.22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs && tsc --noEmit",
    "start": "node scripts/preview.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:staged": "lint-staged",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write app components lib scripts src tests \"*.{ts,mjs,json}\" README.md docs",
    "new:study": "node scripts/new-study.mjs",
    "generate:og": "node scripts/generate-social-image.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-ui": "16.15.11",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/og": "1.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
